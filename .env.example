# Copie este arquivo para .env e ajuste os valores.
# InfluxDB 2.x inicializa automaticamente na primeira subida do container.

# Modo de inicialização: "setup" cria usuario, org, bucket e token.
DOCKER_INFLUXDB_INIT_MODE=setup

# Credenciais do usuario (login na UI do InfluxDB)
# A sua senha deve ter de 8 a 72 caracteres
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=troque_esta_senha

# Organizacao e bucket iniciais
DOCKER_INFLUXDB_INIT_ORG=ufpe
DOCKER_INFLUXDB_INIT_BUCKET=ru_ufpe

# Token de acesso (usado pelos scripts Python e pela API)
# Gere um token forte, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=troque_este_token
